cat > .gitignore <<'EOF'
# virtual environment
.venv/

# simulation output data
data/
data_*/

# binaries and media
*.bin
*.mp4
*.avi
*.mov
*.gif
*.png
*.jpg
*.jpeg
*.pdf
*.svg
*.eps
*.npy
*.npz
*.h5
*.mat

# text output dumps
*.txt
!requirements.txt

# python cruft
__pycache__/
*.pyc
.ipynb_checkpoints/
EOF
# compiled executable
main/gTDGL
