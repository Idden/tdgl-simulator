# ---------------------------------------------------------------------------
# tdgl-simulator
# ---------------------------------------------------------------------------

# --- Python environment ----------------------------------------------------
.venv/
venv/
env/
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/

# --- simulation output -----------------------------------------------------
data/
data_*/

# binary field dumps (psi.bin, vec_pot.bin, Js.bin, Jn.bin, phi.bin,
# div_Js.bin, Jtot.bin, power.bin)
*.bin

# numeric array dumps
*.npy
*.npz
*.h5
*.mat

# HPC sweep results (grid_task*.txt, grid_k*_task*.txt) — thousands of files.
# requirements.txt and anything under docs/ are kept.
*.txt
!requirements.txt
!docs/*.txt
!docs/*.pdf
!docs/*.bib
!docs/photos/*.png

# --- compiled Fortran ------------------------------------------------------
# Linux executables have no extension, so they are listed by exact path.
app/tdgl
sweeps/curr_vs_hp/sweep_curr_hp
sweeps/curr_vs_w0/sweep_curr_w0
sweeps/hp_vs_kappa_vs_size/sweep_hp_kappa_size

# build artifacts
*.o
*.mod
*.smod
*.a
*.exe

# --- cluster job logs ------------------------------------------------------
*.out
*.err
slurm-*.out

# --- figures and video -----------------------------------------------------
# Code-only repo: figures are regenerated by the scripts in figures/.
*.png
*.jpg
*.jpeg
*.svg
*.eps
*.pdf
*.gif
*.mp4
*.avi
*.mov

# --- OS cruft --------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --- LaTeX build artifacts -------------------------------------------------
*.aux
*.toc
*.synctex.gz
*.bbl
*.blg
*.fls
*.fdb_latexmk