# ---------------------------------------------------------------------------
# tdgl-simulator
# ---------------------------------------------------------------------------

# --- Python environment ----------------------------------------------------
.venv/
venv/
env/
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/

# --- simulation output -----------------------------------------------------
data/
data_*/

# binary field dumps (psi.bin, vec_pot.bin, Js.bin, Jn.bin, phi.bin,
# div_Js.bin, Jtot.bin, power.bin)
*.bin

# numeric array dumps
*.npy
*.npz
*.h5
*.mat

# HPC sweep results (grid_task*.txt, grid_k*_task*.txt) — thousands of files.
# requirements.txt and anything under docs/ are kept.
*.txt
!requirements.txt
!docs/*.txt

# --- compiled Fortran ------------------------------------------------------
# Linux executables have no extension, so they are listed by exact path.
app/gTDGL
sweeps/curr_vs_mag/gTDGL_sweep_phase
sweeps/geometry/gTDGL_sweep_width
sweeps/kappa/gTDGL_sweep_kappa
archive/test
archive/save

# build artifacts
*.o
*.mod
*.smod
*.a
*.exe

# fpm
build/

# --- FORD generated documentation ------------------------------------------
# Generated from source comments; regenerate rather than commit.
doc/
docs/html/

# --- cluster job logs ------------------------------------------------------
*.out
*.err
slurm-*.out

# --- figures and video -----------------------------------------------------
# Code-only repo: figures are regenerated by the scripts in figures/.
*.png
*.jpg
*.jpeg
*.svg
*.eps
*.pdf
*.gif
*.mp4
*.avi
*.mov

# --- OS cruft --------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini